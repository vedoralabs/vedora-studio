# Copy this file to `.env.local` for local development.
# Public values are exposed to the browser when prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Vedora Intelligence (server-only; never prefix these with NEXT_PUBLIC_) ---
# Leave AI_API_KEY empty to run in curated mode: every AI feature still works,
# composed from portfolio metadata instead of a language model.
# AI_PROVIDER: anthropic (default) | openai | openai-compatible
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional for anthropic (defaults to claude-opus-5-5). Required for openai and openai-compatible.
AI_MODEL=
# Required for openai-compatible, e.g. https://your-provider.example/v1
AI_BASE_URL=

# --- Smart inquiry delivery (server-only) ---
# An HTTPS endpoint that accepts a JSON POST (Formspree, Zapier, Make, a CRM webhook…).
# Without it, the inquiry flow tells visitors plainly that online sending isn't connected.
INQUIRY_WEBHOOK_URL=
